# Store Care Program — environment variables (NAMES ONLY, no real values here).
# Copy to .env.local for local development and set real values there.
# .env.local is gitignored. Never commit real secrets.
#
# Deployment / provisioning prerequisites still OPEN at scaffold time:
#   - B2: the exact company Google Workspace domain string (ALLOWED_EMAIL_DOMAIN)
#   - B3: the Google OAuth client ID / secret (configured in the Supabase dashboard,
#         Authentication -> Providers -> Google; NOT stored in this repo)
#   - C1: the Supabase project (URL + anon key + direct DB connection string)
#   - C2: the Supabase / Vercel region
# Until these are supplied the app runs but auth and all data access fail safely
# with a Thai "configuration missing" message.

# --- Supabase project (C1) ---
# Public project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Public anon key (safe to expose to the browser; RLS is the real guard).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Auth domain restriction (B2) ---
# The exact Google Workspace domain that sign-in is restricted to, e.g. example.com
# NO DEFAULT. If unset, sign-in is refused for everyone (fail safe).
ALLOWED_EMAIL_DOMAIN=

# --- Site URL (used to build the OAuth redirect) ---
# Local: http://localhost:3000  | Production: the deployed origin
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Migrations only (scripts/migrate.mjs, scripts/export-db.sh) ---
# Direct Postgres connection string for the Supabase database.
# Used ONLY by the migration runner and the pg_dump export script.
# NEVER imported by application code. Keep it out of Vercel's runtime env.
SUPABASE_DB_URL=
